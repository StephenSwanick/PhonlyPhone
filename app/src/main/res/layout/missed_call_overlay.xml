<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="12dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:id="@+id/missed_call_overlay_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/missed_call_overlay_bg"
        android:clickable="true"
        android:elevation="8dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <ImageView
            android:id="@+id/missed_call_overlay_photo"
            android:layout_width="@dimen/missed_call_overlay_avatar"
            android:layout_height="@dimen/missed_call_overlay_avatar"
            android:background="@drawable/missed_call_overlay_avatar"
            android:importantForAccessibility="no"
            android:padding="8dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_phone_green_vector"
            tools:ignore="ContentDescription" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/missed_call_overlay_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/missed_call"
                android:textColor="#FF64748B"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/missed_call_overlay_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textColor="#FF0F172A"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Mom" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
